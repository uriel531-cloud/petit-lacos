# ─────────────────────────────────────────────────────────────
# Petit Laços — variáveis de ambiente
# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o git.
# ─────────────────────────────────────────────────────────────

# ── Banco de dados (obrigatório) ────────────────────────────
# Local: rode `npm run db:dev` e use a URL "postgres://..." que ele mostrar.
# Produção: crie um banco grátis no Neon (neon.tech) ou Supabase (supabase.com)
# e cole a "connection string" (PostgreSQL).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Login do painel — Fase 2 ────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Usuário DONO criado pelo `npm run db:seed` (senha com 10+ caracteres)
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Dona Petit Laços"

# ── Mercado Pago — Fase 6 ───────────────────────────────────
# mercadopago.com.br/developers → Suas integrações → Credenciais
# Use as credenciais de TESTE até a Fase 11.
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Suas integrações → Webhooks → "Assinatura secreta"
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Melhor Envio — Fase 7B (só se ligar "Vender para todo o Brasil") ──
# melhorenvio.com.br → Integrações → Permissões de acesso → Gerar token
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"

# ── E-mails — Fase 8 ────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=""
EMAIL_FROM="Petit Laços <pedidos@seudominio.com.br>"

# ── Imagens dos produtos — Fase 2 (escolher um) ─────────────
# Cloudinary: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analytics — Fase 10 ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
